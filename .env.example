# ==============================================================================
# Konfigurasi Environment EVOSIS
# - Untuk Deploy di Vercel: masukkan variabel di bawah pada menu
#   Vercel Project Settings -> Environment Variables (JANGAN commit file .env).
# - Untuk Development Lokal di PC: salin file ini menjadi ".env.local"
#   (opsional jika sudah memakai fallback default di src/lib/supabase.ts).
# - PENTING: JANGAN pernah menaruh Supabase Service Role Key di variabel VITE_*!
# ==============================================================================

VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"

